# Copy to .env and fill in. Never commit the result — .env is gitignored.
#
# Values are read in two places: docker-compose_*.yml passes them into the
# containers (env_file + explicit environment entries), and Compose itself
# substitutes ${...} in the compose file from this same file.


# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# Which compose variant this directory runs. Required — there is deliberately
# no docker-compose.yml to fall back to, so a directory cannot silently pick up
# the wrong topology.
#   docker-compose_local.yml   local machine (publishes :80 and :8000, Windows cert paths)
#   docker-compose_dev.yml     dev server, behind the edge proxy
#   docker-compose_prod.yml    prod server, behind the edge proxy (-prod container names)
COMPOSE_FILE=docker-compose_dev.yml

# Names the stack. Containers carry explicit container_name values, but the
# project name separates built images (<project>-<service>) and is what
# `docker compose ls` reports. Changing it on a running stack orphans the old
# containers — run `docker compose down` under the OLD name first.
COMPOSE_PROJECT_NAME=befordringssystemet-dev

# Which published image tag dev/prod run (ghcr.io/aak-mbu/befordringssystemet-*,
# built by .github/workflows/docker-publish.yml). Leave unset to follow the
# branch — dev defaults to develop, prod to main. Set sha-<short commit> to pin
# or roll back to one build. Not used by docker-compose_local.yml, which builds.
BEFORDRING_IMAGE_TAG=


# ---------------------------------------------------------------------------
# Frontend (PUBLIC_ prefix — read via $env/dynamic/public, so these reach the
# browser; never put a secret behind this prefix)
# ---------------------------------------------------------------------------

# Where the SvelteKit server reaches the API. Required — backendApi.ts throws
# "Missing PUBLIC_API_BASE_URL" at request time if it is unset.
PUBLIC_API_BASE_URL=

# Browser-facing URLs that start and end the OIDC flow. Both default to the
# same-origin /api/auth/... paths, which assume the edge proxy forwards /api to
# the backend. Only set them where it does not (e.g. local, which publishes the
# API directly on :8000).
PUBLIC_OIDC_LOGIN_URL=
PUBLIC_OIDC_LOGOUT_URL=

# Shown to a user who has no access: where to request a role, and who to ask.
PUBLIC_SYSTEMREGISTER_URL=
PUBLIC_SUPPORT_CONTACT=


# ---------------------------------------------------------------------------
# API authentication
# ---------------------------------------------------------------------------

# Hashes of the API keys accepted for machine-to-machine calls (os2forms, the
# RPAs). This is what the backend actually verifies against.
API_KEY_HASHES=

# The plaintext key issued to callers. Not read by the backend — kept so the
# value deploys alongside its hash.
API_KEY=
BEFORDRING_API_KEY=


# ---------------------------------------------------------------------------
# Database connection strings
# ---------------------------------------------------------------------------

# The application's own database. Required.
DBCONNECTIONSTRINGBEFORDRING=

# LIS database (server 29) — read by Settings.lis_db_connection_string.
DBCONNECTIONSTRINGSERVER29=

# Template-data import source. Used by the templates_handler endpoint.
DBCONNECTIONSTRINGDEV=
DBCONNECTIONSTRINGPROD=


# ---------------------------------------------------------------------------
# OIDC (Azure B2C)
# ---------------------------------------------------------------------------

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Where the IdP sends the browser back after login. Must be registered as a
# reply URL on the app registration, and must match this deployment's host —
# the /callback route is what finishes the flow.
OIDC_REDIRECT_URI=

# Must be Azure B2C's /tfp/ path form, not ?p=<policy> — see
# backend/app/core/oidc.py for why the query form breaks login.
OIDC_DISCOVERY_URL=

# Where the IdP returns the browser after logout. Required — B2C rejects a
# logout request that omits it (AADB2C90036), so an unset value turns every
# logout into an error page. Point it at this deployment's /logged-out.
# Unlike the redirect URI, this does not have to be registered.
OIDC_POST_LOGOUT_REDIRECT=

OIDC_SCOPES=openid
OIDC_ENVIRONMENT=production

# Comma-separated IdP role claim values allowed to write; everyone else is
# read-only. Provisioned in Systemregisteret, so the names can change there
# without a code change. Defaults to admin,user-edit when unset.
EDIT_ROLES=

# Signs the session cookie. MUST be set to a unique random value per
# environment — the code falls back to "dev-only-change-in-prod".
SESSION_SECRET=


# ---------------------------------------------------------------------------
# ATS (work queues for the letter RPAs)
# ---------------------------------------------------------------------------

ATS_TOKEN=
ATS_URL=
ATS_CAPABILITIES=


# ---------------------------------------------------------------------------
# OpenRouteService
# ---------------------------------------------------------------------------

# Token for the Directions and Geocoding APIs — walking distance on Elev, and
# address geocoding. Required: without it every distance and geocode request
# raises, and the nightly RPA's whole walking-distance step fails.
#
# The plan's rate limit belongs to this token, so the nightly run throttles
# itself to match it. Changing to a plan with a different limit means changing
# GAAAFSTAND_PER_MINUTE in rpa-befordring-nightly-runs to match.
ORS_API_KEY=


# ---------------------------------------------------------------------------
# SSL
# ---------------------------------------------------------------------------

# CA bundle used by requests. docker-compose_local.yml overrides this to the
# in-container path (/app/certs/aarhus_root.pem), since the value here is a
# host path.
REQUESTS_CA_BUNDLE=


# ---------------------------------------------------------------------------
# SharePoint / Microsoft Graph
# ---------------------------------------------------------------------------

APPREG_THUMBPRINT=""
CLIENT_ID=""
TENANT=""
